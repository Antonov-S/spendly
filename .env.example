# database
# DATABASE_URL = pooled Neon connection (runtime, has -pooler in host).
# DIRECT_URL  = unpooled Neon connection (Prisma migrations, no -pooler).
DATABASE_URL=""
DIRECT_URL=""

# nextauth
AUTH_SECRET=""
# Base URL used to build absolute links (e.g. email verification). Defaults to
# http://localhost:3000 in dev.
AUTH_URL=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# resend
RESEND_API_KEY=""
# Set to false to skip email verification (useful when no Resend domain is
# configured). Anything other than "false" — including unset — keeps it on.
EMAIL_VERIFICATION_ENABLED="true"

# upstash — auth rate limiting. When either is unset, rate limiting is skipped
# (fails open) so local dev works without a Redis instance.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# stripe — server-only billing integration (no browser Stripe.js, so no
# publishable key). The two price IDs come from the "Spendly Pro" product's
# recurring EUR prices (€3/mo, €25/yr). STRIPE_WEBHOOK_SECRET differs between
# the deployed endpoint and `stripe listen` for local dev.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""
