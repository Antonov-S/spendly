# Codex local secrets — copy to .codex.env (which is gitignored) and fill in.
# The codex.ps1 / codex.sh launchers auto-load KEY=value lines from .codex.env
# into the environment before starting Codex. Never commit .codex.env.
#
# context7 MCP server API key (matches the header in .mcp.json):
CONTEXT7_API_KEY=ctx7sk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
